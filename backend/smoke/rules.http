# backend/smoke/rules.http
#
# end to end checks of the api against a freshly seeded database. run with npm run smoke,
# which resets the database first. requests run top to bottom, and a "# @name" makes that
# response's body available to later requests under that name. every ?? line is an
# assertion, so a run ends in a pass or fail summary

{{
  // dates in the centre's timezone, matching how the api decides what today is
  const centreDate = days => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Singapore' })
    .format(new Date(Date.now() + days * 86_400_000));
  exports.today = centreDate(0);
  exports.twoWeeks = centreDate(13);
  exports.rangeLimit = centreDate(92);
  exports.pastRangeLimit = centreDate(120);
}}

### 1. sign in as each role this file uses
# @name adminLogin
POST {{base}}/api/auth/login
Content-Type: application/json

{ "email": "admin@tuition.com", "password": "{{password}}" }

?? status == 200

###
# @name tutorLogin
POST {{base}}/api/auth/login
Content-Type: application/json

{ "email": "hui.siew@tuition.com", "password": "{{password}}" }

?? status == 200

###
# @name jayLogin
POST {{base}}/api/auth/login
Content-Type: application/json

{ "email": "jaytoh@gmail.com", "password": "{{password}}" }

?? status == 200

### 2. reference data the checks below look things up in
# @name courses
GET {{base}}/api/courses
Authorization: Bearer {{adminLogin.accessToken}}

?? status == 200

###
# @name levels
GET {{base}}/api/levels
Authorization: Bearer {{jayLogin.accessToken}}

?? status == 200

###
# @name jayStudents
GET {{base}}/api/students/mine
Authorization: Bearer {{jayLogin.accessToken}}

?? status == 200

### 3. a parent reading a session none of their children attend gets not found
# @name foreignSessions
GET {{base}}/api/sessions?from={{today}}&to={{twoWeeks}}&courseId={{courses.find(c => c.name === 'JC1 Economics').id}}
Authorization: Bearer {{adminLogin.accessToken}}

?? status == 200
?? js response.parsedBody.length > 0

### jay reads one by id: expect 404, not 403, so the response does not reveal that a
# session he cannot see exists
GET {{base}}/api/sessions/{{foreignSessions[0].id}}
Authorization: Bearer {{jayLogin.accessToken}}

?? status == 404

### 4. a parent's sessions are each labelled with their child; staff lists carry no labels
# @name jaySessions
GET {{base}}/api/sessions?from={{today}}&to={{twoWeeks}}
Authorization: Bearer {{jayLogin.accessToken}}

?? status == 200
?? js response.parsedBody.length > 0
?? js response.parsedBody.every(s => s.viewer_student_ids.length > 0) == true

### the control for 3: a session his own child attends reads normally, so the 404 above
# is the access rule and not a broken endpoint
GET {{base}}/api/sessions/{{jaySessions[0].id}}
Authorization: Bearer {{jayLogin.accessToken}}

?? status == 200

### staff are guardians of nobody, so their lists carry no child labels
GET {{base}}/api/sessions?from={{today}}&to={{twoWeeks}}
Authorization: Bearer {{adminLogin.accessToken}}

?? status == 200
?? js response.parsedBody.every(s => s.viewer_student_ids.length === 0) == true

### 5. a tutor cannot list parents: expect 403. role gates return forbidden, unlike the
# resource guard in 3 which returns not found
GET {{base}}/api/parents
Authorization: Bearer {{tutorLogin.accessToken}}

?? status == 403

### 6. a session range is limited to 92 days
GET {{base}}/api/sessions?from={{today}}&to={{pastRangeLimit}}
Authorization: Bearer {{adminLogin.accessToken}}

?? status == 400

### exactly 92 days is allowed. boundaries are where off by one mistakes hide
GET {{base}}/api/sessions?from={{today}}&to={{rangeLimit}}
Authorization: Bearer {{adminLogin.accessToken}}

?? status == 200

### 7. notification preferences, including events the centre has switched off
GET {{base}}/api/notifications/preferences
Authorization: Bearer {{jayLogin.accessToken}}

?? status == 200
?? js response.parsedBody.length == 8
?? js response.parsedBody.every(p => p.enabled && p.org_enabled) == true

### admin switches session reminders off for the whole centre
PUT {{base}}/api/org/notification-events/session_reminder
Authorization: Bearer {{adminLogin.accessToken}}
Content-Type: application/json

{ "enabled": false }

?? status == 200

### jay again: that row now has org_enabled false while his own choice is unchanged. this
# is the row the account screen greys out
GET {{base}}/api/notifications/preferences
Authorization: Bearer {{jayLogin.accessToken}}

?? status == 200
?? js response.parsedBody.find(p => p.event_key === 'session_reminder').org_enabled == false
?? js response.parsedBody.find(p => p.event_key === 'session_reminder').enabled == true

### jay changes his own preference: the response is the full matrix, so the screen can
# replace its cached copy in one go
PUT {{base}}/api/notifications/preferences
Authorization: Bearer {{jayLogin.accessToken}}
Content-Type: application/json

{ "channel": "email", "eventKey": "invoice_issued", "enabled": false }

?? status == 200
?? js response.parsedBody.length == 8
?? js response.parsedBody.find(p => p.event_key === 'invoice_issued').enabled == false

### put both back
PUT {{base}}/api/org/notification-events/session_reminder
Authorization: Bearer {{adminLogin.accessToken}}
Content-Type: application/json

{ "enabled": true }

?? status == 200

###
PUT {{base}}/api/notifications/preferences
Authorization: Bearer {{jayLogin.accessToken}}
Content-Type: application/json

{ "channel": "email", "eventKey": "invoice_issued", "enabled": true }

?? status == 200

### 8. payment instructions and public branding
PATCH {{base}}/api/org/settings
Authorization: Bearer {{adminLogin.accessToken}}
Content-Type: application/json

{ "payment_instructions": "PayNow UEN 201812345A\nDBS Current 003-901234-5", "landing_headline": "Small classes, real progress", "accent_colour": "#2563EB", "logo_url": "https://example.com/logo.png" }

?? status == 200

### an invalid colour is refused by the shared schema, not by the database
PATCH {{base}}/api/org/settings
Authorization: Bearer {{adminLogin.accessToken}}
Content-Type: application/json

{ "accent_colour": "red" }

?? status == 400

### clearing the logo sends an empty string, which must mean unset rather than fail the
# url check
PATCH {{base}}/api/org/settings
Authorization: Bearer {{adminLogin.accessToken}}
Content-Type: application/json

{ "logo_url": "" }

?? status == 200
?? js response.parsedBody.logo_url == null

### unauthenticated, the public endpoint shows the branding and no private setting
GET {{base}}/api/org/public

?? status == 200
?? js response.parsedBody.landing_headline == Small classes, real progress
?? js 'payment_instructions' in response.parsedBody == false

### jay's invoice detail carries the centre's payment instructions
# @name jayInvoices
GET {{base}}/api/invoices
Authorization: Bearer {{jayLogin.accessToken}}

?? status == 200

###
GET {{base}}/api/invoices/{{jayInvoices[0].id}}
Authorization: Bearer {{jayLogin.accessToken}}

?? status == 200
?? js response.parsedBody.payment_instructions.includes('PayNow') == true

### 9. a level change is refused while enrolled in a level specific class: john is
# enrolled in sec 1 mathematics, which is level specific, so moving him to sec 2 is
# refused, and the refusal names each enrollment by id so the screen can link to it
PATCH {{base}}/api/students/{{jayStudents.find(s => s.first_name === 'John').id}}
Authorization: Bearer {{jayLogin.accessToken}}
Content-Type: application/json

{ "levelId": "{{levels.find(l => l.code === 'S2').id}}" }

?? status == 422
?? js response.parsedBody.error.details.courses.length > 0
?? js response.parsedBody.error.details.courses[0].enrollmentId.length == 36

### 10. admin invites a tutor with no password
# @name branches
GET {{base}}/api/branches

?? status == 200

###
POST {{base}}/api/staff
Authorization: Bearer {{adminLogin.accessToken}}
Content-Type: application/json

{ "email": "invited.tutor@tuition.com", "role": "tutor", "firstName": "Invited", "lastName": "Tutor", "branchIds": ["{{branches[0].id}}"] }

?? status == 201

### the invite is queued: a password reset email to that address
GET {{base}}/api/notifications/outbox
Authorization: Bearer {{adminLogin.accessToken}}

?? status == 200
?? js response.parsedBody.some(n => n.recipient_email === 'invited.tutor@tuition.com' && n.event_key === 'password_reset') == true

### and the account cannot be signed into until the link is used, whatever password is tried
POST {{base}}/api/auth/login
Content-Type: application/json

{ "email": "invited.tutor@tuition.com", "password": "{{password}}" }

?? status == 401

### 11. a guardian can only change their own email preference
# @name evaLogin
POST {{base}}/api/auth/login
Content-Type: application/json

{ "email": "eva.goh@gmail.com", "password": "{{password}}" }

?? status == 200

###
# @name evaStudents
GET {{base}}/api/students/mine
Authorization: Bearer {{evaLogin.accessToken}}

?? status == 200

###
# @name withDavid
POST {{base}}/api/students/{{evaStudents.find(s => s.first_name === 'Daniel').id}}/guardians
Authorization: Bearer {{evaLogin.accessToken}}
Content-Type: application/json

{ "email": "david.koh@gmail.com", "relationship": "father" }

?? status == 201
?? js response.parsedBody.guardians.length == 2

### switching off another guardian's emails is refused
PATCH {{base}}/api/students/{{evaStudents.find(s => s.first_name === 'Daniel').id}}/guardians/{{withDavid.guardians.find(g => g.email === 'david.koh@gmail.com').user_id}}
Authorization: Bearer {{evaLogin.accessToken}}
Content-Type: application/json

{ "receivesNotifications": false }

?? status == 403

### eva is the billing contact, so removing her is refused
DELETE {{base}}/api/students/{{evaStudents.find(s => s.first_name === 'Daniel').id}}/guardians/{{evaLogin.user.id}}
Authorization: Bearer {{evaLogin.accessToken}}

?? status == 422

### removing david is allowed, leaving eva as the only guardian
DELETE {{base}}/api/students/{{evaStudents.find(s => s.first_name === 'Daniel').id}}/guardians/{{withDavid.guardians.find(g => g.email === 'david.koh@gmail.com').user_id}}
Authorization: Bearer {{evaLogin.accessToken}}

?? status == 200
?? js response.parsedBody.guardians.length == 1

### 12. the waitlist has first claim on a freed seat. sec 4 chemistry is full with ryan and
# daniel, and nathan is waiting. withdrawing daniel offers his seat to nathan, so another
# family finds the class still full and joins the queue behind him
# @name sec4Enrolments
GET {{base}}/api/enrollments?courseId={{courses.find(c => c.name === 'Sec 4 Chemistry').id}}&status=active
Authorization: Bearer {{adminLogin.accessToken}}

?? status == 200

###
POST {{base}}/api/enrollments/{{sec4Enrolments.find(e => e.student_name.startsWith('Daniel')).id}}/withdraw
Authorization: Bearer {{adminLogin.accessToken}}
Content-Type: application/json

{ "effectiveOn": "{{today}}" }

?? status == 200
?? js response.parsedBody.status == withdrawn

### jay adds an s4 child
# @name kai
POST {{base}}/api/students/mine
Authorization: Bearer {{jayLogin.accessToken}}
Content-Type: application/json

{ "firstName": "Kai", "lastName": "Toh", "levelId": "{{levels.find(l => l.code === 'S4').id}}", "relationship": "father" }

?? status == 201

### one seat is physically free, but nathan's offer claims it: none are left for newcomers
GET {{base}}/api/courses?studentId={{kai.id}}
Authorization: Bearer {{jayLogin.accessToken}}

?? status == 200
?? js response.parsedBody.find(c => c.name === 'Sec 4 Chemistry').seats_left == 0

### so enrolling is refused, with the waitlist offered instead
POST {{base}}/api/enrollments
Authorization: Bearer {{jayLogin.accessToken}}
Content-Type: application/json

{ "studentId": "{{kai.id}}", "courseId": "{{courses.find(c => c.name === 'Sec 4 Chemistry').id}}" }

?? status == 422
?? js response.parsedBody.error.details.waitlistAvailable == true

### and joining the queue behind nathan is allowed
POST {{base}}/api/waitlist
Authorization: Bearer {{jayLogin.accessToken}}
Content-Type: application/json

{ "studentId": "{{kai.id}}", "courseId": "{{courses.find(c => c.name === 'Sec 4 Chemistry').id}}" }

?? status == 201

### nathan's offer was kept for him: ben accepts it
# @name benLogin
POST {{base}}/api/auth/login
Content-Type: application/json

{ "email": "ben.ng@gmail.com", "password": "{{password}}" }

?? status == 200

###
# @name benWaitlist
GET {{base}}/api/waitlist
Authorization: Bearer {{benLogin.accessToken}}

?? status == 200
?? js response.parsedBody.some(w => w.status === 'offered') == true

###
POST {{base}}/api/waitlist/{{benWaitlist.find(w => w.status === 'offered').id}}/accept
Authorization: Bearer {{benLogin.accessToken}}

?? status == 201
?? js response.parsedBody.status == active